# By default, the app uses SQLite and does not require a DATABASE_URL.
# If you want PostgreSQL instead, uncomment and set the DATABASE_URL below.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/career_copilot

# AI provider API keys
GOOGLE_API_KEY=<google-api-key>
OPENAI_API_KEY=<openai-api-key>
NEXT_PUBLIC_API_BASE_URL=/backend/api/v1

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Apple Sign In
APPLE_CLIENT_ID=<apple-services-id>
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://yourdomain.com/auth/apple/callback
