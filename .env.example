# By default, the app uses SQLite and does not require a DATABASE_URL.
# If you want PostgreSQL instead, set DATABASE_URL below.
# If backend runs on the same Ubuntu server as PostgreSQL:
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/career_copilot
# If backend runs in Docker with a postgres service named `postgres`:
# DATABASE_URL=postgresql://<user>:<password>@postgres:5432/career_copilot
# If your laptop connects to PostgreSQL on another machine:
# DATABASE_URL=postgresql://<user>:<password>@<server-ip>:5432/career_copilot

# AI provider API keys
GOOGLE_API_KEY=<google-api-key>
GOOGLE_MODEL=gemini-2.5-flash
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_API_BASE_URL=/backend/api/v1

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Apple Sign In
APPLE_CLIENT_ID=<apple-services-id>
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://yourdomain.com/auth/apple/callback
