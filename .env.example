# By default, the app uses SQLite and does not require a DATABASE_URL.
# If you want PostgreSQL instead, set DATABASE_URL below.
# By default local development can stay on SQLite.
DATABASE_URL=sqlite:///backend/career_copilot.db
DB_FALLBACK_TO_SQLITE_ON_ERROR=true

# If backend runs on the same Ubuntu server as PostgreSQL:
# DATABASE_URL=postgresql://<user>:<password>@localhost:5432/career_copilot
# If backend runs in Docker with a postgres service named `postgres`:
# DATABASE_URL=postgresql://<user>:<password>@postgres:5432/career_copilot
# If your laptop connects to PostgreSQL on another machine:
# DATABASE_URL=postgresql://<user>:<password>@<server-ip>:5432/career_copilot

# Basic API guardrails
ALLOW_CREDENTIALS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_API_KEY=<admin-api-key>

# AI provider API keys
PHOTO_PROVIDER=google
GOOGLE_API_KEY=<google-api-key>
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
COMFYUI_URL=http://127.0.0.1:8188
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
NEXT_PUBLIC_API_BASE_URL=/backend/api/v1

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Apple Sign In
APPLE_CLIENT_ID=<apple-services-id>
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://yourdomain.com/auth/apple/callback
